{
  "lexicon": 1,
  "id": "com.atproto.repo.putRecord",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Write a repository record, creating or updating it as needed.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["repo", "collection", "rkey", "record"],
          "properties": {
            "repo": { "type": "string", "description": "The DID or handle of the repository." },
            "collection": { "type": "string", "description": "The NSID of the record collection." },
            "rkey": { "type": "string", "maxLength": 512, "description": "The Record Key." },
            "validate": { "type": "boolean" },
            "record": { "type": "unknown", "description": "The record payload to write." }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["uri", "cid"],
          "properties": {
            "uri": { "type": "string" },
            "cid": { "type": "string" }
          }
        }
      }
    }
  }
}

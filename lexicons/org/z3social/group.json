{
  "lexicon": 1,
  "id": "org.z3social.group",
  "defs": {
    "main": {
      "type": "record",
      "key": "tid",
      "description": "Z3 Social community group record.",
      "record": {
        "type": "object",
        "required": ["name", "createdAt"],
        "properties": {
          "name": { "type": "string", "maxLength": 150 },
          "description": { "type": "string", "maxLength": 2000 },
          "avatar": { "type": "string" },
          "banner": { "type": "string" },
          "visibility": { "type": "string", "knownValues": ["public", "private", "unlisted"] },
          "createdAt": { "type": "string" }
        }
      }
    }
  }
}

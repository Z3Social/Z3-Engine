# Z3-Engine Environment Configuration
PORT=3036
NODE_ENV=development

# Sovereign AT-Protocol identifier prefix
Z3_HOST=z3.social
Z3_DID_PREFIX=did:z3:

# PostgreSQL Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/z3_engine
PGHOST=localhost
PGPORT=5432
PGDATABASE=z3_engine
PGUSER=postgres
PGPASSWORD=postgres

# Strict Connection Pool
PGMAX=10
PG_IDLE_TIMEOUT=30000
PG_CONN_TIMEOUT=2000

# Security / Session
JWT_SECRET=z3_sovereign_secret_key_super_safe_and_lightweight
SESSION_TTL_DAYS=30
